# Copiar a .env y ajustar. Todas las variables son opcionales.

# Base de datos SQLite (debe estar en un disco local: WAL no funciona bien en carpetas de red)
ISO_DATABASE_URL=sqlite:///data/iso.db

# Raíz de documentos; no se procesa nada fuera de esta carpeta
ISO_DOCUMENTS_DIR=data/documents

# Límites de consultas de grafo e impacto
ISO_MAX_DEPTH=10
ISO_DEFAULT_DEPTH=2
ISO_GRAPH_MAX_NODES=300
# Tope de nodos del grafo completo (vista "documento a modificar")
ISO_GRAPH_FULL_MAX_NODES=3000

# Log de cada corrida de ingesta (un archivo por corrida; contiene nombres internos)
ISO_LOG_DIR=data/logs
ISO_LOG_LEVEL=INFO

# API (sin autenticación en el MVP: mantener en localhost)
ISO_API_HOST=127.0.0.1
ISO_API_PORT=8000
ISO_CORS_ORIGINS=http://localhost:5173

# TOML opcional con alias de encabezados, terminadores y subgrupos
# ISO_EXTRACTION_CONFIG=config/extraction.toml

# Pruebas opcionales con documentos reales (nunca versionados)
# ISO_REAL_SAMPLES_DIR=samples
# ISO_GOLDEN_SET=golden/expected.csv
